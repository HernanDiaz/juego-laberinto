# Copia este archivo como keystore.properties (en la misma carpeta) y rellena tus datos.
# keystore.properties y el archivo .jks NO se suben a git (están en .gitignore).
# Guarda una copia de seguridad de los dos en un sitio seguro: sin la clave no podrás
# firmar actualizaciones del juego.
storeFile=vueltas-de-la-vida.jks
storePassword=TU_CONTRASEÑA
keyAlias=subida
keyPassword=TU_CONTRASEÑA
